# Voucher desk server settings. Copy to server/.env (git ignores it) and start with `npm run server`.
# On cPanel, deploy/deploy.sh writes this file for you.
#
# Logins: create the mall admin from the command line, then the admin creates each shop's
# login in the desk (Shop logins tab):
#   echo 'PASSWORD' | node index.mjs set-password admin --admin

# Address customers' phones use to open coupon links.
# Leave empty locally: it uses this PC's Wi-Fi address (phones on the same Wi-Fi can open it).
# When hosted, set your public HTTPS address, e.g. https://coupons.dubaimall.dranzo.com
PUBLIC_URL=

# Voucher desk page(s) allowed to use the server, comma-separated.
DESK_ORIGINS=http://localhost:5173

PORT=8787

# Where everything is kept (created automatically): data/coupons.db with SQLite (Node 22.13+),
# otherwise JSON + PNG files under data/. Holds vouchers, logins, sponsors and coupons:
# back this folder up when hosted.
# DATA_DIR=data
# COUPON_STORE=sqlite   # or: files
