# Coupon server settings. Copy to server/.env (git ignores it) and start with `npm run server`.

# Secret the voucher desk sends to upload coupons. Long and random, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Put the same value in the desk's .env.local as VITE_COUPON_API_KEY.
DESK_KEY=

# Address customers' phones use to open coupon links.
# Leave empty locally: it uses this PC's Wi-Fi address (phones on the same Wi-Fi can open it).
# When hosted, set your public HTTPS address, e.g. https://coupons.dubaimalledakkara.com
PUBLIC_URL=

# Voucher desk page(s) allowed to upload, comma-separated.
DESK_ORIGINS=http://localhost:5173

PORT=8787

# SQLite database file (created automatically). Back this file up when hosted.
# DB_FILE=server/data/coupons.db
