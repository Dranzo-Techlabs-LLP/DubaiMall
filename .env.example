# Voucher desk → its server (server/index.mjs)
#
# The desk needs its server for everything: shop and admin logins, vouchers, sponsors and the
# coupon download links. Copy this file to .env.local (git ignores it), then run both:
#   npm run server
#   npm run dev
#
# First time locally, create the mall admin login (then make shop logins in the desk):
#   cd server && node index.mjs set-password admin --admin
#   (type the password, press Enter, then Ctrl+D / Ctrl+Z Enter)
#
# On the live site this comes from desk-config.js, which deploy/deploy.sh writes.

# Where the desk reaches its server. Locally: http://localhost:8787
VITE_COUPON_API_URL=http://localhost:8787
