# Voucher desk → coupon server (server/index.mjs)
#
# WhatsApp chat links can only carry text, so the desk saves each coupon image on the
# mall's own coupon server and puts a link to it in the greeting message. The customer
# taps the link, sees their coupon and downloads it.
# Leave these empty and the desk falls back to copy-and-paste (Ctrl+V) of the image.
#
# Copy this file to .env.local (git ignores it) and restart `npm run dev`.

# Where the desk reaches the coupon server. Locally: http://localhost:8787
# When hosted: https://coupons.your-domain
VITE_COUPON_API_URL=http://localhost:8787

# Must be exactly the DESK_KEY in server/.env
VITE_COUPON_API_KEY=
